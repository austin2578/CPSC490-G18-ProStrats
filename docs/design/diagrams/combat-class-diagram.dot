digraph Classes { graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.6]; node [shape=plain, fontname="Arial"]; edge [fontname="Arial", fontsize=10];
StartingClass [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#deebf7"><B>StartingClass</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;conceptual profile&gt;&gt;<BR ALIGN="LEFT"/>startingAttributes : Vigor Strength Dexterity Mind Constitution<BR ALIGN="LEFT"/>startingResources : Health Stamina Mana<BR ALIGN="LEFT"/>startingEquipment : class-specific initial loadout<BR ALIGN="LEFT"/>persistentPassive : reinforces class identity<BR ALIGN="LEFT"/>progression : invest in any attribute<BR ALIGN="LEFT"/>equipmentAccess : any weapon family</TD></TR></TABLE>>];
Knight [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#deebf7"><B>Knight</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;starting playable class&gt;&gt;<BR ALIGN="LEFT"/>statInclination : Vigor Strength Constitution<BR ALIGN="LEFT"/>startingValues : undecided<BR ALIGN="LEFT"/>startingEquipment : undecided<BR ALIGN="LEFT"/>resourceProfile : undecided<BR ALIGN="LEFT"/>passiveExample : damage reduction - not final<BR ALIGN="LEFT"/>passiveStrength : undecided</TD></TR></TABLE>>];
Mage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#deebf7"><B>Mage</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;starting playable class&gt;&gt;<BR ALIGN="LEFT"/>statInclination : Mind with moderate utility stats<BR ALIGN="LEFT"/>startingValues : undecided<BR ALIGN="LEFT"/>startingEquipment : undecided<BR ALIGN="LEFT"/>resourceProfile : undecided<BR ALIGN="LEFT"/>passiveIdentity : magical or elemental play - not final<BR ALIGN="LEFT"/>passiveEffect : undecided</TD></TR></TABLE>>];
Thief [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#deebf7"><B>Thief</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;starting playable class&gt;&gt;<BR ALIGN="LEFT"/>statInclination : Dexterity with flexible secondary stats<BR ALIGN="LEFT"/>startingValues : undecided<BR ALIGN="LEFT"/>startingEquipment : undecided<BR ALIGN="LEFT"/>resourceProfile : undecided<BR ALIGN="LEFT"/>passiveIdentity : opportunist play - not final<BR ALIGN="LEFT"/>passiveEffect : undecided</TD></TR></TABLE>>];
Archer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="9"><TR><TD BGCOLOR="#deebf7"><B>Archer</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;starting playable class&gt;&gt;<BR ALIGN="LEFT"/>statInclination : undecided<BR ALIGN="LEFT"/>startingValues : undecided<BR ALIGN="LEFT"/>startingEquipment : undecided<BR ALIGN="LEFT"/>resourceProfile : undecided<BR ALIGN="LEFT"/>passiveIdentity : archery-oriented play<BR ALIGN="LEFT"/>passiveEffect : undecided</TD></TR></TABLE>>];
StartingClass -> Knight [dir=back, arrowtail=empty, label="starting profile"];
StartingClass -> Mage [dir=back, arrowtail=empty, label="starting profile"];
StartingClass -> Thief [dir=back, arrowtail=empty, label="starting profile"];
StartingClass -> Archer [dir=back, arrowtail=empty, label="starting profile"];
}
